{
  "name": "secop-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI assistant query Colombia's public procurement data (SECOP II) in natural language.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "secop-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "secop",
    "socrata",
    "open-data",
    "colombia",
    "public-procurement"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
